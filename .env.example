# =============================================================================
# kiro-essentials — Environment Configuration
# =============================================================================
# This file documents all environment variables used across workspaces.
# Copy this file to .env and fill in your values.
#
# Tip (cross-platform — Windows, macOS, Linux): `npm run init` creates this .env
# for you on a fresh clone; then `npm run setup` fills in the VITE_* values
# automatically from the deployed CloudFormation outputs.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Access Keys (workshop sandbox accounts)
# Used by: the AWS SDK / CDK during `npm run setup` and the deploy scripts
#
# Workshop sandbox accounts do NOT use IAM Identity Center / SSO, so you
# authenticate with temporary access keys. Paste the values provided for your
# sandbox here. If a session token is given (temporary credentials), include it.
# These are read by the setup/deploy scripts; they are NOT exposed to the browser.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=your-session-token-if-temporary
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# AWS Cognito Authentication
# Used by: @kiro-essentials/web
# -----------------------------------------------------------------------------
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=your-app-prefix.auth.us-east-1.amazoncognito.com

# -----------------------------------------------------------------------------
# Redirect URIs (OAuth 2.0 Authorization Code Flow with PKCE)
# Used by: @kiro-essentials/web
# -----------------------------------------------------------------------------
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_LOGOUT_URI=http://localhost:5173/login

# -----------------------------------------------------------------------------
# API Gateway Configuration
# Used by: @kiro-essentials/web
# -----------------------------------------------------------------------------
VITE_API_URL=
