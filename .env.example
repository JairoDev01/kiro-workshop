# =============================================================================
# kiro-essentials — Environment Configuration (LOCAL mode)
# =============================================================================
# Copy this file to .env (it is gitignored) and adjust if needed. Everything
# runs locally: the Vite frontend and a local Express API. There is no AWS at
# runtime (no CDK / API Gateway / Lambda / DynamoDB / Cognito). Auth is mocked.
#
# Start everything with:  npm run dev:local
# =============================================================================

# -----------------------------------------------------------------------------
# Local API — the frontend calls this. This is the only variable that matters
# for local mode.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Legacy / unused in local mode — kept only as documentation.
# These were used by the original AWS/Cognito deployment and are NOT read at
# runtime in local mode. Leave them blank. Never commit real values.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_LOGOUT_URI=http://localhost:5173/login
